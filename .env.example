# Supabase 프로젝트 설정 (Supabase 대시보드 -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# OCTOMO 전화번호 인증 API Key (production에서는 필수. 비어 있으면 개발 환경에서만 데모 통과)
OCTOMO_API_KEY=your-octomo-api-key-here

# 회원 세션 쿠키 서명 키 (필수. 없으면 로그인 불가. ADMIN_SECRET_KEY와 다른 값 사용)
MEMBER_SESSION_SECRET=generate-another-random-64-char-hex-secret

# 관리자 전용 보안 인증 정보 (Admin Portal Security Credentials)
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-super-strong-password
ADMIN_SECRET_KEY=generate-a-random-64-char-hex-secret


# 서버 전용 Supabase 키 (필수: 마이그레이션 이후 anon 키로는 데이터 접근 불가)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 알림톡 버튼 링크 기준 주소 / Vercel Cron 인증
NEXT_PUBLIC_SITE_URL=https://get-profile-info.vercel.app
CRON_SECRET=generate-a-random-secret

# 카카오 알림톡 (SOLAPI). 비어 있으면 발송만 건너뜀
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_PF_ID=
SOLAPI_TEMPLATE_MATCH=
SOLAPI_SENDER=
